ngx_addon_name=ngx_http_limit_traffic_rate_filter_module

TRAFFIC_MODULE_SRCS="$ngx_addon_dir/ngx_http_limit_traffic_rate_filter_module.c"

if test -n "$ngx_module_link"; then
    # nginx >= 1.9.11: auto/module, supports --add-dynamic-module
    ngx_module_type=HTTP_AUX_FILTER
    ngx_module_name=$ngx_addon_name
    ngx_module_incs=
    ngx_module_deps=
    ngx_module_srcs="$TRAFFIC_MODULE_SRCS"
    ngx_module_libs=

    . auto/module
else
    # older nginx: legacy addon config
    HTTP_AUX_FILTER_MODULES="$HTTP_AUX_FILTER_MODULES $ngx_addon_name"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $TRAFFIC_MODULE_SRCS"
fi
